<?xml version="1.0" encoding="utf-8"?>
<!-- L'aperçu du sélecteur de widgets (Android 12 et plus) : la forme du widget, avec un exemple de lecture. Plus ancien :
     previewImage (drawable-nodpi/widget_apercu.png), une capture du widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/apercu_commune"
            android:textColor="@color/encre"
            android:textSize="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apercu_lue"
            android:textColor="@color/attenue"
            android:textSize="11dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apercu_temperature"
        android:textColor="@color/encre"
        android:textSize="36dp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apercu_mesure"
        android:textColor="@color/attenue"
        android:textSize="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_pastille_verte"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/apercu_vigilance"
        android:textColor="@color/sur_vert"
        android:textSize="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apercu_zone"
        android:textColor="@color/attenue"
        android:textSize="11dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apercu_officiel"
        android:textColor="@color/lien"
        android:textSize="11dp" />
</LinearLayout>
