<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Les notifications d'alerte (Android 13 et plus : demandée à l'ouverture de l'appli) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".android.RundataApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rundata">

        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La commune d'un widget, choisie quand on le pose -->
        <activity
            android:name=".android.widget.ChoixCommuneWidget"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Rundata">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Les cinq widgets du sélecteur, du plus petit au plus grand -->
        <receiver
            android:name=".android.widget.RecepteurTemperature"
            android:exported="true"
            android:label="@string/widget_temperature_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_temperature" />
        </receiver>
        <receiver
            android:name=".android.widget.RecepteurBandeau"
            android:exported="true"
            android:label="@string/widget_bandeau_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bandeau" />
        </receiver>
        <receiver
            android:name=".android.widget.RecepteurWidget"
            android:exported="true"
            android:label="@string/widget_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rundata" />
        </receiver>
        <receiver
            android:name=".android.widget.RecepteurAujourdhui"
            android:exported="true"
            android:label="@string/widget_aujourdhui_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aujourdhui" />
        </receiver>
        <receiver
            android:name=".android.widget.RecepteurAlerte"
            android:exported="true"
            android:label="@string/widget_alerte_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alerte" />
        </receiver>
    </application>

    <!-- Les onglets du navigateur (Custom Tabs) : voir les navigateurs installés, Android 11 et plus -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
