// The trial Worker of the alerts on the phone (src/web/alertes.ts), apart from production's wrangler.jsonc, which it
// never changes. Its own address on workers.dev (HTTPS, which Web Push needs; no DNS), its own D1 database and VAPID
// key, and NO scheduled event, so that the sources are never read twice. Only the alerts' addresses are meant to be
// used there: no KV, none of production's other bindings. It serves production's static files (the fonts, icons and
// images the service worker keeps for offline use), else the service worker cannot install and /alertes cannot
// subscribe a phone. ALERTES_ESSAI opens those addresses.
//
// Set up once, from the repository (the database's id, not a secret, is in database_id below since step 1):
//   1. npx wrangler d1 create rundata-essai
//   2. npx wrangler d1 execute rundata-essai -c wrangler.essai.jsonc --remote --file scripts/alertes.sql
//   3. node scripts/vapid-cles.mjs | npx wrangler secret put VAPID_PRIVE -c wrangler.essai.jsonc
//   4. the team's secret, for the test send: npx wrangler secret put EQUIPE_JETON -c wrangler.essai.jsonc
//   5. npx wrangler deploy -c wrangler.essai.jsonc
// Then POST /alertes/essai with the header rundata-jeton sends the test message to every subscription. To stop it:
// npx wrangler delete -c wrangler.essai.jsonc (the database stays, npx wrangler d1 delete rundata-essai removes it).
{
  "name": "rundata-essai",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/demo/*"] },
  "preview_urls": false,
  "vars": { "ALERTES_ESSAI": "1" },
  "d1_databases": [{ "binding": "AVIS", "database_name": "rundata-essai", "database_id": "b4ac7d04-82bb-4573-b478-10f91d646594" }],
  "ratelimits": [{ "name": "LIMITE_FORMULAIRES", "namespace_id": "974902", "simple": { "limit": 20, "period": 60 } }]
}
